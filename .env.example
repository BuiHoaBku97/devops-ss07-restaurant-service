RESTAURANT_SERVICE_PORT=8080
POSTGRES_PORT=5432

CORE_DB_USERNAME=postgres
CORE_DB_PW=postgres
CORE_DB_URL=jdbc:postgresql://cart-db-container:5432/cartdb

# Repository URL used to register the self-hosted runner.
GITHUB_REPOSITORY_URL=https://github.com/<owner>/restaurant-service
# GitHub PAT with repository administration permission to create runner registration tokens.
GITHUB_RUNNER_ACCESS_TOKEN=github_pat_replace_me
